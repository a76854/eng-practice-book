# deploy-demo — minimal backend image (teaching)
# FROM python:3.12-slim + m2t (no torch/funasr, keeps demo build fast)
FROM python:3.12-slim
WORKDIR /app

# System deps for soundfile/librosa (libsndfile1) — keep layer cache-friendly
RUN apt-get update \
    && apt-get install -y --no-install-recommends libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

# Copy only teaching package (m2t) — selective COPY keeps context small
COPY pyproject.toml README.md ./
COPY m2t/ ./m2t/

# Install project (m2t) + runtime deps
RUN pip install --no-cache-dir -e .

ENV MTT_DATA_DIR=/data
RUN mkdir -p /data

EXPOSE 8000

# Minimal serve command (m2t.cli is the teaching entry; MeetingToText uses `meetingtotext serve`)
CMD ["python", "-m", "m2t.cli", "serve", "--host", "0.0.0.0", "--port", "8000"]
