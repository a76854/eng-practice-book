# 复制本文件为 .env，填入你要用的 key（.env 已在 .gitignore 中，不会被提交）。
#
# 本地构建前先加载环境变量，并清掉执行缓存（环境变量变化不会使缓存失效）：
#   set -a && source .env && set +a
#   myst clean --execute -y && myst build --html --execute --strict
#
# 只填你要用的 key，不需要的请留空。占位文本（如 your-key-here）会被当成真值，
# 导致相关 cell 发起真实调用并报鉴权失败；留空则走降级分支，不影响构建。

# 网页搜索（tavily）：第 3、4、7 章的搜索示例使用
WEBSEARCH_API_KEY=

# 大模型调用（DeepSeek 接口，模型 deepseek-flash 对应 DeepSeek-V4.1-Flash）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash