# 复制本文件为 .env 并填入真实 key（.env 已在 .gitignore 中，不会被提交）。
# 构建前先加载环境变量：
#   set -a && source .env
# 然后执行 myst build --html --execute --strict。
WEBSEARCH_API_KEY=your-key-here
# 大模型调用（DeepSeek 接口，模型 deepseek-flash 对应 DeepSeek-V4.1-Flash）：
# 无 key 时书中 cell 自动降级为跳过，不影响构建。
LLM_API_KEY=your-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash